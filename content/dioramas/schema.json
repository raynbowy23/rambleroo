{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bywayId",
    "title",
    "longitude",
    "ground",
    "palette",
    "snowInWinter",
    "road",
    "landmarks",
    "dressing",
    "towns",
    "sources",
    "geometryNotes",
    "authored"
  ],
  "properties": {
    "bywayId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "ground": {
      "enum": [
        "coastal-cliff",
        "alpine-plateau",
        "forested-ridges",
        "low-shore",
        "river-valley",
        "desert-mesas",
        "prairie-grid",
        "main-street"
      ]
    },
    "palette": {
      "enum": [
        "coast",
        "mountain",
        "forest",
        "river",
        "desert",
        "prairie",
        "town"
      ]
    },
    "snowInWinter": {
      "type": "boolean"
    },
    "road": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "profile",
        "lanes",
        "coordinates",
        "elevation"
      ],
      "properties": {
        "shape": {
          "const": "from-geometry"
        },
        "profile": {
          "enum": [
            "cliff-shelf",
            "switchbacks",
            "valley-floor",
            "rolling",
            "level"
          ]
        },
        "lanes": {
          "const": 2
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 80,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "elevation": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "landmarks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "model",
          "at",
          "offset",
          "notes"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "enum": [
              "open-spandrel-arch-bridge",
              "covered-bridge",
              "lighthouse-on-rock",
              "cove-waterfall",
              "farmhouse",
              "ski-lift",
              "overlook-pullout",
              "false-front-town",
              "conifer",
              "hardwood",
              "cypress",
              "sea-stack",
              "snowfield",
              "alpine-lake",
              "river",
              "surf",
              "fog-bank",
              "gristmill",
              "viaduct",
              "dam",
              "paddlewheeler",
              "sandbar",
              "steeple-town",
              "harbor",
              "ledge",
              "orchard",
              "ridge",
              "bald",
              "snow-peak",
              "switchback",
              "aspen",
              "hoodoo",
              "mesa",
              "field",
              "town-blocks"
            ]
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "offset": {
            "enum": [
              "on-road",
              "roadside",
              "seaward"
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dressing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "at",
          "side",
          "distance",
          "scale"
        ],
        "properties": {
          "model": {
            "enum": [
              "open-spandrel-arch-bridge",
              "covered-bridge",
              "lighthouse-on-rock",
              "cove-waterfall",
              "farmhouse",
              "ski-lift",
              "overlook-pullout",
              "false-front-town",
              "conifer",
              "hardwood",
              "cypress",
              "sea-stack",
              "snowfield",
              "alpine-lake",
              "river",
              "surf",
              "fog-bank",
              "gristmill",
              "viaduct",
              "dam",
              "paddlewheeler",
              "sandbar",
              "steeple-town",
              "harbor",
              "ledge",
              "orchard",
              "ridge",
              "bald",
              "snow-peak",
              "switchback",
              "aspen",
              "hoodoo",
              "mesa",
              "field",
              "town-blocks"
            ]
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "side": {
            "enum": [
              -1,
              1
            ]
          },
          "distance": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 2
          }
        }
      }
    },
    "towns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "at",
          "landmark"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "at": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "landmark": {
            "type": "string"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "geometryNotes": {
      "type": "string"
    },
    "authored": {
      "type": "boolean"
    }
  }
}

{
  "name": "rambleroo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "test": "vitest run",
    "ingest:fetch": "tsx scripts/ingest/fetch-sources.ts",
    "ingest:build": "tsx scripts/ingest/build-catalog.ts",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests *.ts",
    "dev:phone": "vite --host",
    "strips:build": "tsx scripts/strips/build-strip.ts",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler versions upload"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@types/three": "^0.186.0",
    "maplibre-gl": "^6.11.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/react": "^16.3.3",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^27.0.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.9",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.147.0"
  }
}

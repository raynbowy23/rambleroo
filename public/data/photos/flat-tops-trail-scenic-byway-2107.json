op along the drive.","author":"Roy Brumback","license":"CC BY-SA 3.0","licenseUrl":"http://creativecommons.org/licenses/by-sa/3.0/","sourceUrl":"https://commons.wikimedia.org/wiki/File:Trappers_Lake.JPG","source":"wikipedia-lead"}]